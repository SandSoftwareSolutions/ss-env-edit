{
  "name": "@sandsoftwaresolutions/env-edit",
  "version": "0.1.1",
  "description": "Edit .env files from code and keep comments, order, quotes and line endings. Quoting done right.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "dotenv",
    "env",
    "config",
    "edit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-env-edit.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-env-edit/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-env-edit#readme",
  "publishConfig": {
    "access": "public"
  }
}
